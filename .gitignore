/plugins/*
!/plugins/.gitkeep
# First-party plugin: tracked. Its Composer dependencies are not.
!/plugins/optimum-lift-plans/
/plugins/optimum-lift-plans/vendor/
/uploads/*
!/uploads/.gitkeep

# Build output and dependencies
/node_modules/
/vendor/
/themes/optimum-lift/assets/dist/

# Diet PDFs and the renderer's own dependencies
/content/diets/out/
/content/diets/node_modules/
