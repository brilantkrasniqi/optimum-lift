{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "768px",
      "wideSize": "1200px"
    },
    "color": {
      "custom": false,
      "customDuotone": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "paper", "name": "Paper", "color": "#07080A" },
        { "slug": "surface", "name": "Surface", "color": "#0D1012" },
        { "slug": "raised", "name": "Raised", "color": "#14181B" },
        { "slug": "line", "name": "Line", "color": "#24292E" },
        { "slug": "ink", "name": "Ink", "color": "#E4E4E7" },
        { "slug": "ink-muted", "name": "Ink muted", "color": "#A1A1AA" },
        { "slug": "accent", "name": "Accent", "color": "#E41B23" },
        { "slug": "accent-light", "name": "Accent light", "color": "#FF3B4A" },
        { "slug": "acid", "name": "Acid", "color": "#C6FF3D" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Inter",
          "fontFamily": "Inter, system-ui, -apple-system, \"Segoe UI\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "Inter",
              "fontStyle": "normal",
              "fontWeight": "300 900",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/inter-latin-wght-normal.woff2"],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        },
        {
          "slug": "display",
          "name": "Anton",
          "fontFamily": "Anton, Impact, system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Anton",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/anton-latin-400-normal.woff2"],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
            }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "medium", "name": "Medium", "size": "1rem" },
        { "slug": "large", "name": "Large", "size": "1.375rem" },
        { "slug": "x-large", "name": "Extra large", "size": "2rem" }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw"]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)"
    }
  }
}
